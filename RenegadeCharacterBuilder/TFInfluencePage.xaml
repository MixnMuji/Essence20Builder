<Page x:Class="RenegadeCharacterBuilder.TFInfluencePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TFInfluencePage"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Influences and Hang ups" FontSize="25" FontStretch="UltraExpanded"/>
        <TabControl Grid.Row="1">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Influences" FontSize="18" Background="LightGray"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding tfInfluences}" Grid.Row="2" >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                       
                            <StackPanel Margin="10,10,10,10">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding isChecked, Mode=TwoWay}"/>
                                    <TextBlock Text="{Binding Perk}" TextWrapping="Wrap"/>
                                </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hang Ups" FontSize="18" Background="LightGray"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding tfHangups}" Grid.Row="2" Grid.Column="1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,10,10,10">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding isChecked, Mode=TwoWay}"/>

                                    <TextBlock Text="{Binding Effect}"  TextWrapping="Wrap"/>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
   

        
       
        
        <Button Content="To Roles!" Click="ProceedToRoles" Grid.Row="2" Width="100" Height="40" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
        


    </Grid>
</Page>
