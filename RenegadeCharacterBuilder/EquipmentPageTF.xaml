<Page x:Class="RenegadeCharacterBuilder.EquipmentPageTF"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

      xmlns:gear="clr-namespace:RenegadeCharacterBuilder.Models.Transformers.GearTFChildrenClasses"
      xmlns:support="clr-namespace:RenegadeCharacterBuilder.Models.Transformers"

      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="EquipmentPageTF"
      Background="White">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row ="0">
            <TextBlock Text="Equipment Page" FontSize="24"/>
            <TextBlock Text="Choose your equipment"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBox Text="Set your Reqesution point per gm" x:Name="UsersRecVal"/>
                <Button Content="Sumbit" Width="30"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="{Binding  requistionPoints, StringFormat= Requistion Points: {0}}"/>
                <TextBlock Text="{Binding HardpointLimit, StringFormat= Free Hardpoints: {0}}"/>
            </StackPanel>
        </StackPanel>
        
        <!-- TAB STUFF BEGINS-->
        <TabControl Grid.Row="1" SelectionChanged="EquipmentTabChanged">
            <!-- TAB ONE  -->
            <TabItem Tag="Trained">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="DimGray"/>
                        <TextBlock Text="Gear you are trained in." FontSize="14"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"
         ItemsSource="{Binding EquipmentTypeView}"
         SelectedItem="{Binding ChosenListToView}">
                    </ListBox>


                    <ListBox Grid.Column="1"
         ItemsSource="{Binding CurrentViewedList}">

                        <ListBox.Resources>
                            <!-- WEAPON -->
                            <DataTemplate DataType="{x:Type gear:WeaponTF}">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"  FontSize="16"/>
                                    <TextBlock Text="{Binding availibility}"/>
                                    <TextBlock Text="{Binding Classification}"/>
                                    <TextBlock Text="{Binding Hands,StringFormat=Hands: {0}}"/>
                                    <TextBlock Text="{Binding Range,StringFormat=Range: {0}}"/>
                                    <TextBlock Text="{Binding Effect}"/>
                                    <Button Content="Add Item" Click="AddItem"/>
                                </StackPanel>
                            </DataTemplate>


                            <!-- ARMOR / KIT -->
                            <DataTemplate DataType="{x:Type gear:Upgrades}">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding availibility}"/>
                                    <TextBlock Text="{Binding Benefit}"/>
                                    <Button Content="Add Item" Click="AddItem"/>
                                </StackPanel>
                            </DataTemplate>


                            <!-- SUPPORT EQUIPMENT -->
                            <DataTemplate DataType="{x:Type support:SupportEqupmentTF}">
                                <StackPanel Margin="5">

                                    <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding prereq}"/>
                                    <TextBlock Text="{Binding altmodeEffect}"/>
                                    <TextBlock Text="{Binding botmodeEffect}"/>
                                    <Button Content="Add Item" Click="AddItem"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
            </TabItem>

            
            <!-- TAB TWO -->
            <TabItem Tag="Untrained">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="DimGray"/>
                        <TextBlock Text="Gear that you must Requistion" FontSize="14"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"
ItemsSource="{Binding EquipmentTypeView}"
SelectedItem="{Binding ChosenListToView}">
                    </ListBox>


                    <ListBox Grid.Column="1"
ItemsSource="{Binding CurrentViewedList}">

                        <ListBox.Resources>
                            <!-- WEAPON -->
                            <DataTemplate DataType="{x:Type gear:WeaponTF}">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"  FontSize="16"/>
                                    <TextBlock Text="{Binding availibility}"/>
                                    <TextBlock Text="{Binding Classification}"/>
                                    <TextBlock Text="{Binding Hands,StringFormat=Hands: {0}}"/>
                                    <TextBlock Text="{Binding Range,StringFormat=Range: {0}}"/>
                                    <TextBlock Text="{Binding Effect}"/>
                                    <Button Content="Add Item" Click="AddItem"/>
                                </StackPanel>
                            </DataTemplate>


                            <!-- ARMOR / KIT -->
                            <DataTemplate DataType="{x:Type gear:Upgrades}">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding availibility}"/>
                                    <TextBlock Text="{Binding Benefit}"/>
                                    <Button Content="Add Item" Click="AddItem"/>
                                </StackPanel>
                            </DataTemplate>


                            <!-- SUPPORT EQUIPMENT -->
                            <DataTemplate DataType="{x:Type support:SupportEqupmentTF}">
                                <StackPanel Margin="5">

                                    <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding prereq}"/>
                                    <TextBlock Text="{Binding altmodeEffect}"/>
                                    <TextBlock Text="{Binding botmodeEffect}"/>
                                    <Button Content="Add Item" Click="AddItem"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
            </TabItem>
            
            <!-- TAB THREE-->
            <TabItem Tag="Taken">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="DimGray"/>
                        <TextBlock Text="Gear Taken" FontSize="14"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"
ItemsSource="{Binding EquipmentTypeView}"
SelectedItem="{Binding ChosenListToView}">
                    </ListBox>


                    <ListBox Grid.Column="1"
ItemsSource="{Binding CurrentViewedList}">

                        <ListBox.Resources>
                            <!-- WEAPON -->
                            <DataTemplate DataType="{x:Type gear:WeaponTF}">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"  FontSize="16"/>
                                    <TextBlock Text="{Binding availibility}"/>
                                    <TextBlock Text="{Binding Classification}"/>
                                    <TextBlock Text="{Binding Hands,StringFormat=Hands: {0}}"/>
                                    <TextBlock Text="{Binding Range,StringFormat=Range: {0}}"/>
                                    <TextBlock Text="{Binding Effect}"/>
                                    <Button Content="Add Item" Click="AddItem"/>
                                </StackPanel>
                            </DataTemplate>


                            <!-- ARMOR / KIT -->
                            <DataTemplate DataType="{x:Type gear:Upgrades}">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding availibility}"/>
                                    <TextBlock Text="{Binding Benefit}"/>
                                    <Button Content="Add Item" Click="AddItem"/>
                                </StackPanel>
                            </DataTemplate>


                            <!-- SUPPORT EQUIPMENT -->
                            <DataTemplate DataType="{x:Type support:SupportEqupmentTF}">
                                <StackPanel Margin="5">

                                    <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding prereq}"/>
                                    <TextBlock Text="{Binding altmodeEffect}"/>
                                    <TextBlock Text="{Binding botmodeEffect}"/>
                                    <Button Content="Add Item" Click="RemoveItem"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>

            </TabItem>
        
        </TabControl>
        
        
        

       
    </Grid>
    
</Page>
