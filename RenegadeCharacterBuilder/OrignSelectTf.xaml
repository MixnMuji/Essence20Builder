<Page x:Class="RenegadeCharacterBuilder.OrignSelectTf"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrignSelectTf"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions >
            <ColumnDefinition Width ="200"/>
            <ColumnDefinition Width ="200"/>
            <ColumnDefinition Width ="*"/>
        </Grid.ColumnDefinitions>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding tfOrgins}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,10">
                        <RadioButton  Content="{Binding Name}" GroupName="tfOrgins" Checked="OriginSelected"/>
                        <Expander Header="Details" Margin="10,0,0,0" HorizontalAlignment="Stretch">

                            <StackPanel Margin="10">
                                <TextBlock Text="{Binding StartingHealth, StringFormat= Starting Health: {0}}"/>
                                <TextBlock Text="Origin Skill:" FontWeight="Bold"/>
                                <TextBlock Text="{Binding OriginSkill}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding StrengthIncrease, StringFormat= Strength Essence Increase:{0}}"/>
                                <TextBlock Text="{Binding SmartsIncrease, StringFormat= Smarts Essence Increase:{0}}"/>
                                <TextBlock Text="{Binding SocialIncrease, StringFormat= Social Essence Increase:{0}}"/>
                                <TextBlock Text="{Binding SpeedIncrease, StringFormat= Speed Essence Increase:{0}}"/>

                                <TextBlock Text="Botmode:" FontWeight="Bold"/>
                                <TextBlock Text="{Binding BotMode.Movement, StringFormat= Movement: {0}}"/>
                                <TextBlock Text="{Binding BotMode.Type, StringFormat= Movement Type: {0}}"/>
                                <TextBlock Text="{Binding BotMode.Size, StringFormat= Size: {0}}"/>

                                <TextBlock Text="Altmode" FontWeight="Bold"/>
                                <TextBlock Text="{Binding AltMode.Movement, StringFormat= Movement:{0}}"/>
                                <TextBlock Text="{Binding AltMode.Type, StringFormat= Movement Type: {0}}"/>
                                <TextBlock Text="{Binding AltMode.Crew, StringFormat= Crew Size: {0}}"/>
                                <TextBlock Text="{Binding AltMode.FirePoints, StringFormat= Firepoints: {0}}"/>
                                <TextBlock Text="{Binding AltMode.Attack, StringFormat= Altmode Attack :{0}}" TextWrapping="Wrap"/>

                                <TextBlock Text="Benefit:" FontWeight="Bold"/>
                                <TextBlock Text="{Binding OriginBenefit.Name}"/>
                                <TextBlock Text="{Binding OriginBenefit.Effect}" TextWrapping="Wrap"/>
                            </StackPanel>
                          
                        </Expander>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
       
        <Button Grid.Column="2"
                Grid.Row="2"
                Content="Continue To Influences"
                Height="200"
                Width="200"
                Click="ToInfluences"/>

    </Grid>
</Page>
