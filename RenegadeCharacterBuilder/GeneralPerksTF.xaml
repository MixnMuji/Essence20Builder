<Page x:Class="RenegadeCharacterBuilder.GeneralPerksTF"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="GeneralPerksTF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="General Perks" FontSize="33"/>
        
        <!-- Page logic in grid.row 1-->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPagePerks}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <CheckBox>
                        <StackPanel DataContext="{Binding Gps}">
   
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding Text}"/>
                        </StackPanel>
                    </CheckBox>

                </DataTemplate>
            </ContentControl.ContentTemplate>
            
        </ContentControl>
        
        <!-- Controls for navigation-->
        <Button Grid.Row="2" Content="Next" HorizontalAlignment="Right" Height="50" Width="100" Margin="10,0,10,0" Command="{Binding NextPage}"/>
        <Button Grid.Row="2" Content="Previous" HorizontalAlignment="Left" Height="50" Width="100" Margin="10,0,10,0" Command="{Binding PreviousPage}"/>

        <Button Grid.Row="3" HorizontalAlignment="Right" Content="Continue" Width="200" Height="50" Margin="10"/>
    </Grid>
</Page>
