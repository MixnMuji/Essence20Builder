<Page x:Class="RenegadeCharacterBuilder.GeneralPerksTF"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="GeneralPerksTF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="General Perks" FontSize="33"/>
        <TextBlock Grid.Row="0" Text="{Binding GeneralPerksPointBank, StringFormat='Total Perks To Choose : {0}'}" HorizontalAlignment="Right"/>
        <!-- Page logic in grid.row 1-->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding CurrentPagePerks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding isSelected, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>

                </DataTemplate>
            </ItemsControl.ItemTemplate>
            
        </ItemsControl>
        
        <!-- Controls for navigation-->
        <Button Grid.Row="2" Content="Next" HorizontalAlignment="Right" Height="50" Width="100" Margin="10,0,10,0" Command="{Binding NextPage}"/>
        <Button Grid.Row="2" Content="Previous" HorizontalAlignment="Left" Height="50" Width="100" Margin="10,0,10,0" Command="{Binding PreviousPage}"/>

        <Button Grid.Row="3" HorizontalAlignment="Right" Content="Continue" Width="200" Height="50" Margin="10" Click="ContinueAndGetApplyPerk"/>
    </Grid>
</Page>
