<Page x:Class="RenegadeCharacterBuilder.CharcterFluffPageTF"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CharcterFluffPageTF"
      Background="White">

    <Grid>
        <!-- Needs  Name/ Pronoun / Level / Alliegence /Descreption -->
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="50"/>
          
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Grid.Row="0" Text="Character Info"/>
            <TextBlock Text="Select Character's level:"/>
            <ComboBox x:Name="ComboBoxLevels" Width="100" HorizontalAlignment="Left"></ComboBox>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        

       <!-- Name -->
        <StackPanel Grid.Row="0" Grid.Column="0">
        <TextBlock Text="Name"/>
        <TextBox>Your Character's Name</TextBox>
                <!-- Pronouns -->
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="Description"/>
                <TextBox>Your Characters Description</TextBox>
            </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock Text="Pronouns"/>
                <TextBox>Your Character's Pronouns</TextBox>

            </StackPanel>
            <!-- Alleigence  Figure out how to add pics-->
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="Characters Faction"></TextBlock>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Name="AutoBot"  Checked="FactionChoice" Content="AutoBot" />
                    <RadioButton Name="Decepticon" Checked="FactionChoice" Content="Decepticon"/>
                </StackPanel>

            </StackPanel>

        </Grid>
    </Grid>
</Page>
