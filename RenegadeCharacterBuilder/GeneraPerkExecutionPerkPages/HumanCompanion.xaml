<Page x:Class="RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages.HumanCompanion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages"
      xmlns:gm="clr-namespace:RenegadeCharacterBuilder.GlobalMethods"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HumanCompanion"
      Background="White">

    <Page.Resources>
        <gm:DieConverter x:Key="intToDie"/>
    </Page.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="320"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
            </Grid.RowDefinitions>
        <!-- row 0 -->
        <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Build Your Human Companion" FontSize="34"/>
            <TextBox x:Name="CompanionsName" FontSize="22">Enter you Companions name:</TextBox>
        </StackPanel>
           
           <TextBlock Grid.Row="0" Grid.Column="1" Text="PointsBank:" VerticalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PointsBank}" VerticalAlignment="Bottom" FontSize="20"/>
            
           <TextBlock Grid.Row="0" Grid.Column="1" Text="Skills PointsBank:" VerticalAlignment="Center" Margin="100,10,10,10" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SkillsPointBank}" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="20"/>
        </Grid>
            
        <!-- row 1-->
        
            <ItemsControl ItemsSource="{Binding Scores}" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Grid.Row= "0"  Content= "-" Command="{Binding DataContext.RemovePointsFromScore, RelativeSource= {RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "0,0,50,0" VerticalAlignment= "Bottom" />
                            <TextBlock Text="{Binding CurrentRank}" HorizontalAlignment= "Center" Margin= "0,0,0,2" VerticalAlignment= "Bottom" />
                            <Button Grid.Row= "0" Content= "+" Command="{Binding DataContext.AddpointsToScore, RelativeSource= {RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "5,0,-50,0" VerticalAlignment= "Bottom"  />
                        </StackPanel>

                        <!-- Skills-->
                        <ItemsControl ItemsSource="{Binding CorrespondingSkills}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button  Content= "-" Command="{Binding DataContext.RemovePointsFromSkill, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "0,0,50,0" VerticalAlignment= "Bottom"/>
                                            <TextBlock Text="{Binding SkillScore, Converter={StaticResource intToDie}}" HorizontalAlignment= "Center" Margin= "0,0,0,2" VerticalAlignment= "Bottom" />
                                            <Button  Content= "+" Command="{Binding DataContext.AddPointsToSkill, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "5,0,-50,0" VerticalAlignment= "Bottom" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
            
        <!-- row 2-->
        <Button Grid.Row="2" HorizontalAlignment="Right" Margin="10,0,10,10" Height="50" Width="200" Content="Make Companion and move on" Click="Countinue"/>
    </Grid>
</Page>
