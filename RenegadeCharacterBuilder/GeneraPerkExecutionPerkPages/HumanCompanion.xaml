<Page x:Class="RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages.HumanCompanion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages"
      xmlns:gm="clr-namespace:RenegadeCharacterBuilder.GlobalMethods"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HumanCompanion"
      Background="White">

    <Page.Resources>
        <gm:DieConverter x:Key="intToDie"/>
    </Page.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

       
        <!-- row 0 -->
        <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Build Your Companion" FontSize="32"/>
            <TextBox x:Name="CompanionsName" HorizontalAlignment="Left" FontSize="18" Width="200" Visibility="Visible">Enter Companion's name:</TextBox>
           
        </StackPanel>
       
        
        <StackPanel Grid.Row="0" HorizontalAlignment="Right">
            <TextBlock  Text="PointsBank:" Margin="10,0,200,10" FontSize="20"/>
            <TextBlock  Text="{Binding PointsBank}" Margin="10,5,200,10" VerticalAlignment="Bottom" FontSize="20"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Grid.Row="0">
            <TextBlock Text="Skills PointsBank:" Margin="10,0,20,10"  FontSize="20"/>
            <TextBlock Grid.Column="1" Text="{Binding SkillsPointBank}" Margin="10,5,20,10" FontSize="20"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <!-- row 1-->
        <Grid >
            <StackPanel>
                <StackPanel x:Name="MiniconSettingsAfter10"  Orientation="Horizontal" Visibility="Hidden">
                <RadioButton Name="SecondPurpose" GroupName="Modemaster10Options" Content="Give MiniCon Second Purpose"  Click="SetModeMasterVisibitlity" Margin="10,10,10,10"/>
                <RadioButton Name="SecondCon" GroupName="Modemaster10Options" Content="Make a new MiniCon" Click="SetModeMasterVisibitlity" Margin="10,10,10,10"/>
                
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Scores}"  x:Name="ScoreView" Visibility="Visible">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Grid.Row= "0"  Content= "-" Command="{Binding DataContext.RemovePointsFromScore, RelativeSource= {RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "0,0,50,0"  />
                                    <TextBlock Text="{Binding CurrentRank}" HorizontalAlignment= "Center" Margin= "0,0,0,2"  />
                                    <Button Grid.Row= "0" Content= "+" Command="{Binding DataContext.AddpointsToScore, RelativeSource= {RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "5,0,-50,0"  />
                                </StackPanel>

                                

                                <!-- Skills-->
                                <ItemsControl ItemsSource="{Binding CorrespondingSkills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button  Content= "-" Command="{Binding DataContext.RemovePointsFromSkill, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "0,0,50,0" VerticalAlignment= "Bottom"/>
                                                    <TextBlock Text="{Binding SkillScore, Converter={StaticResource intToDie}}" HorizontalAlignment= "Center" Margin= "0,0,0,2" VerticalAlignment= "Bottom" />
                                                    <Button  Content= "+" Command="{Binding DataContext.AddPointsToSkill, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "5,0,-50,0" VerticalAlignment= "Bottom" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- If Compainion Exist -->
                <StackPanel Grid.Row="1"  x:Name="ExistingMinicon" Visibility="Hidden">
                    <TextBlock Text="{Binding MiniconHelperVm.MiniconName,StringFormat= Your MiniCon: {0}}"  HorizontalAlignment="Left" FontSize="18" Width="200"/>
                    <TextBlock Text="{Binding MiniconHelperVm.originalPurpose,StringFormat=Purpose 1: {0}}" />
                    <ItemsControl ItemsSource="{Binding MiniconHelperVm.scoreValues}" >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentRank}" HorizontalAlignment= "Center" Margin= "0,0,0,2"  />
                                </StackPanel>



                                <!-- Skills-->
                                <ItemsControl ItemsSource="{Binding CorrespondingSkills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SkillScore, Converter={StaticResource intToDie}}" HorizontalAlignment= "Center" Margin= "0,0,0,2" VerticalAlignment= "Bottom" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
                <!-- Companion Choices-->
                <StackPanel x:Name="ModeMasterBit" Visibility="Hidden">
                    <TextBlock Text="Pick a skill to determine your Companion's Purpose:" Margin="0,20,10,10" FontSize="15"/>
                <ItemsControl ItemsSource="{Binding purposeOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <RadioButton GroupName="Purpose_Options" Content="{Binding Name}" Click="SetPurpose" FontSize="13" Margin="0,10,10,10" />
                            </StackPanel>
                        </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <!-- row 2-->
        <Button Grid.Row="2" HorizontalAlignment="Right" Margin="10,0,10,10" Height="40" Width="200" Content="Make Companion and move on" Click="Countinue"/>
    </Grid>
</Page>
