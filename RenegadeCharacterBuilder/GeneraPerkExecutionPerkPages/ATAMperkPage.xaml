<Page x:Class="RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages.ATAMperkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ATAMperkPage"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="All Terrain Alt Mode Perk Application " FontSize="44"/>
        <Grid Grid.Row ="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width ="*"/>
            <ColumnDefinition Width ="*"/>
            
        </Grid.ColumnDefinitions>

            <!-- Where all the user altmodes go-->
              <StackPanel Grid.Column="0">
                <TextBlock Text="Your Altmodes:" FontSize="19"/>
                <ListBox  ItemsSource="{Binding OriginsTogetModesFrom }"  SelectedItem="{Binding SelectedAltMode}">
                <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding  AltMode.Movement, StringFormat= Movement :{0}}"/>
                                    <TextBlock Text="{Binding  AltMode.Type, StringFormat= Movement type: {0}}"/>
                                    <TextBlock Text="{Binding  AltMode.Size, StringFormat= Size: {0}}"/>
                                    <TextBlock Text="{Binding  AltMode.FirePoints, StringFormat= Firepoints: {0}}"/>
                                    <TextBlock Text="{Binding  AltMode.Type, StringFormat= Movement type: {0}}"/>
                                    <TextBlock Text="{Binding  AltMode.Attack, StringFormat= Attack:{0}}"/>


                                </StackPanel>
                       
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </StackPanel>

            <!-- Where the altmodes go-->
            <StackPanel Grid.Column="1">
            <TextBlock Text="Pick a Movement type to add to your Altmode" FontSize="18"></TextBlock>
                <ListBox   ItemsSource="{Binding aplicableMoveTypes}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                         
                                    <TextBlock Text="{Binding}"/>
                                
                        </StackPanel>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </StackPanel>
            
            <Button Grid.Column="1"  Content="Add movment" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="150" Margin="10"/>

        </Grid>

    </Grid>
</Page>
