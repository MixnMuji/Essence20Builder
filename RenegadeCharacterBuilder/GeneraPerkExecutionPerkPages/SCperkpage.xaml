<Page x:Class="RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages.SCperkpage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SCperkpage"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
            <TextBlock Text="Size Change Perk" FontSize="39"/>
            <TextBlock Text="Choose a altmode to change it's size:" FontSize="26"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding choices}" SelectedItem="{Binding Selection}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding  Movement, StringFormat= Movement :{0}}"/>
                            <TextBlock Text="{Binding  Type, StringFormat= Movement type: {0}}"/>
                            <TextBlock Text="{Binding  Size, StringFormat= Size: {0}}"/>
                            <TextBlock Text="{Binding  FirePoints, StringFormat= Firepoints: {0}}"/>
                            <TextBlock Text="{Binding  Type, StringFormat= Movement type: {0}}"/>
                            <TextBlock Text="{Binding  Attack, StringFormat= Attack:{0}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
            </ListBox>
            
            <StackPanel Grid.Column="1">
                <TextBlock Text=" Choose a new size for your altmode:" FontSize="15"/>
                <ListBox  ItemsSource="{Binding  afterSizeLogic}" SelectedItem="{Binding ChosenSize}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
            </StackPanel>
        </Grid>

        <Button Grid.Row="2" Content="Continue" Click="Continue" Width="200" Height="50" HorizontalAlignment="Right" Margin="10,10,10,10"/>
    </Grid>
</Page>
