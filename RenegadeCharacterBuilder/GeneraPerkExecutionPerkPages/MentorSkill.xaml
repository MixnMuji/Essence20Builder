<Page x:Class="RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages.MentorSkill"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MentorSkill"
      Background="White"
      >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Gridrow 1-->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Mentor Skill Perk" FontSize="38"/>
            <TextBlock Text="Choose your skill and corresponding score:" FontSize="28"/>
        </StackPanel>
        <!-- Grid.row 1 stuff -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!--Skills -->
            <ListBox Grid.Column="0"
         ItemsSource="{Binding Skills}"
         x:Name="selectedSkill"/>

            <!-- scores-->
            <ListBox Grid.Column="1"
         ItemsSource="{Binding Scores}"
         x:Name="selectedScore"/>
        </Grid>
        
        <!-- Grid 2-->
        <Button Grid.Row="2" Content="Confirm Skill and associated score." Click="Confrim" Width="200" Height="70" Margin="10,10,10,10" HorizontalAlignment="Right" />

    </Grid>
</Page>
