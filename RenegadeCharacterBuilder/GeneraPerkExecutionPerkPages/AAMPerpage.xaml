<Page x:Class="RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages.AAMPerpage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AAMPerpage"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Choose An additonal Alt mode" FontWeight="Bold" FontSize="33"/>
        
        <!--List of almodes -->
        <ItemsControl ItemsSource="{Binding altmodeChoices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <RadioButton>
                            <StackPanel>
                                <TextBlock Text="{Binding Movment, StringFormat= Movement :{0}}"/>
                                <TextBlock Text="{Binding Type, StringFormat= Movement type: {0}}"/>
                                <TextBlock Text="{Binding Size, StringFormat= Size: {0}}"/>
                                <TextBlock Text="{Binding FirePoints, StringFormat= Firepoints: {0}}"/>
                                <TextBlock Text="{Binding Type, StringFormat= Movement type: {0}}"/>
                                <TextBlock Text="{Binding Attack, StringFormat= Attack:{0}}"/>



                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DataTemplate>
                
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
    </Grid>
</Page>
