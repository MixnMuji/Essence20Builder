<Page x:Class="RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages.AAMPerpage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder.GeneraPerkExecutionPerkPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AAMPerpage"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Choose An additonal Alt mode" FontWeight="Bold" FontSize="33"/>
        
        <!--List of almodes -->
        <ItemsControl ItemsSource="{Binding}" Grid.Row="1">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <RadioButton GroupName="selectedAltmode" Click="setnewAltmode">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding  AltMode.Movement, StringFormat= Movement :{0}}"/>
                                <TextBlock Text="{Binding  AltMode.Type, StringFormat= Movement type: {0}}"/>
                                <TextBlock Text="{Binding  AltMode.Size, StringFormat= Size: {0}}"/>
                                <TextBlock Text="{Binding  AltMode.FirePoints, StringFormat= Firepoints: {0}}"/>
                                <TextBlock Text="{Binding  AltMode.Type, StringFormat= Movement type: {0}}"/>
                                <TextBlock Text="{Binding  AltMode.Attack, StringFormat= Attack:{0}}"/>



                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DataTemplate>
                
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="2" Content="Continue" Click="figureOutWhatToDo"/>
    </Grid>
</Page>
