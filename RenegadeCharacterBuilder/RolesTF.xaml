<Page x:Class="RenegadeCharacterBuilder.RolesTF"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RolesTF"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
      
            <ContentControl Content="{Binding CurrentRole}" Grid.Row="0">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="24"/>
                            <TextBlock Text="{Binding CyberTronianPerk}" TextWrapping="Wrap"/>

                            <StackPanel DataContext="{Binding Training}">
                                <TextBlock Text="{Binding EssenceIncrease, StringFormat= Essence Increase: {0}}"/>
                                <TextBlock Text="{Binding Score, StringFormat=Score Increased: {0}}"/>
                                <TextBlock Text="{Binding RolesSkills, StringFormat=Skill Pool: {0}}"/>
                            </StackPanel>



                            <StackPanel DataContext="{Binding Qualifications}">
                                <TextBlock Text="{Binding ArmorUpgrades, StringFormat= Armor Qualifications: {0}}"/>
                                <TextBlock Text="{Binding Weapons, StringFormat=Weapon Qualifications: {0}}"/>
                            </StackPanel>
                        </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>

        </ContentControl>
        <!-- Need break here put in space 1-->

                        <Grid Grid.Row ="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Levels" FontSize="24" FontWeight="Medium"/>
                <ListBox ItemsSource="{Binding levelTable}" SelectedItem="{Binding CurrentSelectedLevel}"/>
            </StackPanel>

            <ContentControl Content="{Binding CurrentDisplayedLevel}" Grid.Column="1">
                               <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,10,10,10">
                                        <TextBlock Text="{Binding Level, StringFormat= Level : {0}}"/>
                                        <TextBlock Text="{Binding GeneralPerkCount, StringFormat= Gernal Perk Count: +{0}}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding FocusProgression, StringFormat= Focus Progression: +{0}}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SpeedBoost, StringFormat= Speed Essence: +{0}}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SmartsBoost, StringFormat= Smarts Essence: +{0}}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding StrengthBoost, StringFormat= Strength Essence: +{0}}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SocialBoost, StringFormat= Social Essence: +{0}}" TextWrapping="Wrap"/>


                                        <StackPanel Margin="10,5,0,5" DataContext="{Binding Perk}">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Effect}" TextWrapping="Wrap"/>
                                        </StackPanel>


                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>


       

        <Button Content="Next Role" HorizontalAlignment="Center" Margin="200,0,0,0" Grid.Row="2" Width="100" Height="30" Click="NextRoleDisplay"/>
        <Button Content="Pervious Role" HorizontalAlignment="Center" Margin="-600,0,0,0" Grid.Row="2" Width="100" Height="30" Click="PerviousRoleDisplay"/>
        <Button Content="Select Current Role and Continue" HorizontalAlignment="Right" Grid.Row="2"  Margin="10,10,10,10" Click="ContinueToGeneralPerks"/>

    </Grid>
</Page>
