<Page x:Class="RenegadeCharacterBuilder.HybridizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HybridizationPage"
      Background="White">
    
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
            <TextBlock FontSize="32" Text="Hybirdization Page"/>
            <TextBlock Margin="10,10,10,10" Text="{Binding HybridPointBank, StringFormat= Remaining Slections: {0}}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding HybridOptions}" Grid.Row="1">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding}" Click="ChecklegalityOfchoice"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="2" Content="Countinue" Click="SetdataAndProceed" Height="60" Width="200" HorizontalAlignment="Right" Margin="10,10,10,10"></Button>
    </Grid>
</Page>
