<Page x:Class="RenegadeCharacterBuilder.FinalPageAndConfirmation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FinalPageAndConfirmation"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        
        <StackPanel x:Name="view1" Visibility="{Binding showDataSet1}">
            
                <TextBlock Text="{Binding character.Name}"/>

        </StackPanel>
       <StackPanel Visibility=""
    </Grid>
</Page>
