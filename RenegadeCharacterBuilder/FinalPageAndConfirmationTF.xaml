<Page x:Class="RenegadeCharacterBuilder.FinalPageAndConfirmation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FinalPageAndConfirmation"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        
        <StackPanel x:Name="view1" Grid.Row="1" DataContext="{Binding}">
            
                <TextBlock Text="{Binding Name,StringFormat= Character Name: {0}}"/>

        </StackPanel>
        <StackPanel x:Name="view2" Grid.Row="1">
            <TextBlock Text="2 Working"/>
        </StackPanel>
        <StackPanel x:Name="view3" Grid.Row="1">
            <TextBlock Text="3 working"/>
        </StackPanel>
        <Button Content="next" Grid.Row="2" Width="70" Click="Moveup" HorizontalAlignment="Right" Margin="0,0,30,0"/>
        <Button Content="Pervious" Grid.Row="2" Width="70" Click="MoveBack" HorizontalAlignment="Left" Margin="30,0,0,0"/>
    </Grid>
</Page>
