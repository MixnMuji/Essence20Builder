<Page x:Class="RenegadeCharacterBuilder.ScoreSkillAllocationTF"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      xmlns:gm="clr-namespace:RenegadeCharacterBuilder.GlobalMethods"
 
    mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ScoreSkillAllocationTF"
      Background="White">

    <Page.Resources>
        <gm:DieConverter x:Key="intToDie"/>
    </Page.Resources>



        <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="360"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

     
            
      
        <Grid Grid.Row="1">
            
                <TabControl>
                    
                        <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="DimGray"/>
                            <TextBlock Text="1) Key Esscencse"/>
                        </StackPanel>
                    </TabItem.Header>
                     
                            <Grid x:Name="StatsToDisplay">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="330"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Drag and drop your stats" FontSize="24"/>
                                    <ItemsControl ItemsSource="{Binding Scores}" Grid.Column="0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Border BorderBrush="Black" BorderThickness="2" Padding="5" CornerRadius="5" MouseMove="DragStat">
                                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" />
                                                </Border>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    
                            <TextBlock Margin="10,10,10,10" Text="Pick two scores to raise at level 1"/>
                            <ItemsControl ItemsSource="{Binding Scores}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding }">
                                            
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                                   
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,10,10,10">
                                    <TextBlock Text="Rank Your score Choices"/>
                                    <Border BorderBrush="Black" BorderThickness="2" Padding="5" CornerRadius="5">
                                        <TextBlock x:Name="Stat1" DragOver="stat_dragOver" AllowDrop="True" Drop="SetScore"></TextBlock>
                                    </Border>
                                    <TextBlock Text="Increases on levels 2,5,9,14,18,20" Margin="0,-2,10,10"/>

                                    <Border BorderBrush="Black" BorderThickness="2" Padding="5" CornerRadius="5">
                                        <TextBlock x:Name="Stat2" DragOver="stat_dragOver" AllowDrop="True" Drop="SetScore"></TextBlock>
                                    </Border>
                                    <TextBlock Text="Increases on levels 3,7,11,15,19" Margin="0,-2,10,10"/>

                                    <Border BorderBrush="Black" BorderThickness="2" Padding="5" CornerRadius="5">
                                        <TextBlock x:Name="Stat3" DragOver="stat_dragOver" AllowDrop="True" Drop="SetScore"></TextBlock>
                                    </Border>
                                    <TextBlock Text="Increases on levels 4,8,13,16" Margin="0,-2,10,10"/>

                                    <Border BorderBrush="Black" BorderThickness="2" Padding="5" CornerRadius="5">
                                        <TextBlock x:Name="Stat4" DragOver="stat_dragOver" AllowDrop="True" Drop="SetScore"></TextBlock>
                                    </Border>
                                    <TextBlock Text="Increases on levels 6,12,17" Margin="0,-2,10,10"/>


                                </StackPanel>
                            </Grid>
                    </TabItem>
                
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="DimGray"/>
                                <TextBlock Text="1) Skill Boost from Orign"/>
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding oringName}" FontWeight="Bold" FontSize="28"/>
                            <TextBlock Text="Pick a Skill to Boost"/>
                            <ItemsControl ItemsSource="{Binding originBoostOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="OriginSkillSelected" Content="{Binding Name}" Checked="Doupdate"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        
                    </TabItem>
                    
                    
                 <!-- tab 3 -->   
                    
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="DimGray"/>
                            <TextBlock Text="1) Key Score and Skill Selection"/>
                        </StackPanel>
                    </TabItem.Header>
                    <!-- stuff for key socres -->

                    <StackPanel>
                        <TextBlock Text="{Binding CharacterRoleForKeyScores, StringFormat='Your Current Role: {0}'}"/>
                        <TextBlock Text="Select 2 Skills as your key skills."/>

                        <ItemsControl ItemsSource="{Binding SkillsToBoost}">
                        <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"></CheckBox>
                                </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </TabItem>
                
                <!-- Tab 2 socres and stuff-->
                <TabItem>
                    <TabItem.Header >
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="DimGray"/>
                            <TextBlock Text=" 2) Scores And Skill Allocation"/> 
                        </StackPanel>
                    </TabItem.Header>
                    <ItemsControl ItemsSource="{Binding Scores}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"/>
                            <StackPanel Orientation="Horizontal">
                            <Button Grid.Row= "0"  Content= "-" Command="{Binding DataContext.RemovePointsFromScore, RelativeSource= {RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "0,0,50,0" VerticalAlignment= "Bottom" />
                            <TextBlock Text="{Binding CurrentRank}" HorizontalAlignment= "Center" Margin= "0,0,0,2" VerticalAlignment= "Bottom" />
                            <Button Grid.Row= "0" Content= "+" Command="{Binding DataContext.AddpointsToScore, RelativeSource= {RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "5,0,-50,0" VerticalAlignment= "Bottom"  />
                            </StackPanel>
                            
                            <!-- Skills-->
                            <ItemsControl ItemsSource="{Binding CorrespondingSkills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button  Content= "-" Command="{Binding DataContext.RemovePointsFromSkill, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "0,0,50,0" VerticalAlignment= "Bottom"/>
                                                        <TextBlock Text="{Binding SkillScore, Converter={StaticResource intToDie}}" HorizontalAlignment= "Center" Margin= "0,0,0,2" VerticalAlignment= "Bottom" />
                                                <Button  Content= "+" Command="{Binding DataContext.AddPointsToSkill, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10"  Margin= "5,0,-50,0" VerticalAlignment= "Bottom" />
                                            </StackPanel>
                                            </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
            </ItemsControl>
                </TabItem>
                    
            </TabControl>
            
        </Grid>
      
        <!-- Header Stuff-->
        <TextBlock Grid.Row="0" Text="Scores and Skills:" FontSize="33"/>
        <TextBlock Grid.Row="0" HorizontalAlignment="Right" Text="{Binding PointsBank, StringFormat= Remaining Points : {0}}"/>

        <Button Grid.Row="2" HorizontalAlignment="Right" Width="200" Content="Proceed" Click="SaveScoresAndSkillsAndProcced" />

    </Grid>

    

</Page>
