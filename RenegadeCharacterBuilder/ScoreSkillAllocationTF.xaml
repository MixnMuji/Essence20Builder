<Page x:Class="RenegadeCharacterBuilder.ScoreSkillAllocationTF"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ScoreSkillAllocationTF"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="360"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="1">
            

            <ItemsControl ItemsSource="{Binding Scores}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"/>
                            <Button Grid.Row= "0"  Content= "-" Command="{Binding DataContext.RemovePointsFromScore, RelativeSource= {RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10" HorizontalAlignment= "Center" Margin= "0,0,50,0" VerticalAlignment= "Bottom" />
                            <TextBlock Text="{Binding CurrentRank}" HorizontalAlignment= "Center" Margin= "0,0,0,2" VerticalAlignment= "Bottom" />
                            <Button Grid.Row= "0" Content= "+" Command="{Binding DataContext.AddpointsToScore, RelativeSource= {RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Height= "15" Width= "10" HorizontalAlignment= "Center" Margin= "5,0,-50,0" VerticalAlignment= "Bottom" Tag= "Strength" />

                            <ItemsControl ItemsSource="{Binding SkillsTF}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
            </ItemsControl>
          
            
        </Grid>
      
        <!-- Header Stuff-->
        <TextBlock Grid.Row="0" Text="Scores and Skills"/>
        <TextBlock Grid.Row="0" HorizontalAlignment="Right" Text="{Binding PointsBank, StringFormat= Remaining Points : {0}}"/>
    </Grid>
</Page>
