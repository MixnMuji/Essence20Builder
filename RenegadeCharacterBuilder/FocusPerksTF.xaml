<Page x:Class="RenegadeCharacterBuilder.FocusPerks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FocusPerks"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Focuses" FontSize="33"/>
        <ContentControl Grid.Row="1" Content="{Binding CurrentSubclass}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <StackPanel>

                        <TextBlock Text="{Binding subclassName}"/>
                        <TextBlock Text="{Binding statToBoost, StringFormat= Stat boosted +1: {0}}"/>
                        <TextBlock Text="Select a skill to raise whenever you boost your key score"/>

                        <!--Should show list of skills -->
                        <ItemsControl ItemsSource="{Binding skillsToboost}" x:Name="SkillBank" Visibility="Visible">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding}" Checked="SkllChosen" GroupName="Skills"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Mode master Stuff-->

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Hidden"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.isModeMaster, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                            </StackPanel.Style>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width=" 400"/>
                                    <ColumnDefinition Width=" 400"/>

                                </Grid.ColumnDefinitions>

                                <ListBox Grid.Column="0" ItemsSource="{Binding DataContext.ModeMasterEsscenceOptions,RelativeSource={RelativeSource AncestorType={x:Type Page}}}"  
                                     SelectedItem="{Binding DataContext.ChosenModeMasterEssence, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Mode=TwoWay}" >

                                </ListBox>


                                <ListBox Grid.Column="1" ItemsSource="{Binding DataContext.CorrespondingSkills,RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                     SelectedItem="{Binding DataContext.ChosenModeMasterSkill,RelativeSource={RelativeSource AncestorType={x:Type Page}}}"/>

                            </Grid>
                        </StackPanel>

                        <!--Mode master Finished-->
                        
    
                                <ItemsControl ItemsSource="{Binding ranks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                       
                                        <StackPanel>
                                        <TextBlock Text="{Binding AbilityName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding AbilityEffect}" TextWrapping="Wrap"/>


                                    </StackPanel>
                                  
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      


                    </StackPanel>
                 
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
        
        <!-- Buttons for next and right put it in its own row just above -->
        <Button Content="Next" VerticalAlignment="Bottom" Grid.Row="2" HorizontalAlignment="Right"  Width="100" Height="50" Margin="10,0,10,10" Command="{Binding DispalyNextSubclass}"/>
        <Button Content="Previous" VerticalAlignment="Bottom" Grid.Row="2" HorizontalAlignment="Left"  Width="100" Height="50" Margin="10,0,10,10" Command="{Binding DisplayPreviousSubclass}"/>
        <Button Grid.Row="3" Content="Select Subclass and continue" HorizontalAlignment="Right"  Width="300" Height="50" Margin="10,0,10,10" Click="SetSubclassandContinue"/>
    </Grid>
</Page>
