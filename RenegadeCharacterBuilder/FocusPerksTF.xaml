<Page x:Class="RenegadeCharacterBuilder.FocusPerks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RenegadeCharacterBuilder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FocusPerks"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Focuses" FontSize="33"/>
        <ContentControl Grid.Row="1" Content="{Binding CurrentSubclass}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <StackPanel>

                        <TextBlock Text="{Binding subclassName}"/>
                        <TextBlock Text="{Binding statToBoost, StringFormat= Stat boosted +1: {0}}"/>
                        <TextBlock Text="Select a skill to raise whenever you boost your key score"/>

                        <!--Should show list of skills -->
                        <ItemsControl ItemsSource="{Binding skillsToboost}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding ranks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AbilityName}"/>
                                        <TextBlock Text="{Binding AbilityEffect}"/>


                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>



                    </StackPanel>
                 
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
        
        <!-- Buttons for next and right put it in its own row just above -->
        <Button Content="Next" VerticalAlignment="Bottom" Grid.Row="1" HorizontalAlignment="Right"  Width="100" Height="50" Margin="10,0,10,10" Command="{Binding DispalyNextSubclass}"/>
        <Button Content="Previous" VerticalAlignment="Bottom" Grid.Row="1" HorizontalAlignment="Left"  Width="100" Height="50" Margin="10,0,10,10" Command="{Binding DisplayPreviousSubclass}"/>
        <Button Grid.Row="2" Content="Select Subclass and continue" HorizontalAlignment="Right"  Width="300" Height="50" Margin="10,0,10,10" Click="SetSubclassandContinue"/>
    </Grid>
</Page>
